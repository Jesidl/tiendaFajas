@servicio = http://localhost:5250
@usuario = admin@tiendafajas.com

# Todos los endpoints son POST con cuerpo JSON, incluidos Consultar y
# Buscar: es la convencion del servicio. Desde el navegador responden 405.
#
# La cabecera X-Usuario es la que el servicio registra en la auditoria.

### Auditorias

POST {{servicio}}/Auditorias/Insertar
Content-Type: application/json
X-Usuario: {{usuario}}

{
  "Entidad": "Cargos",
  "Llave": 1,
  "Operacion": "Insertar",
  "Usuario": "admin@tiendafajas.com",
  "Fecha": "2026-11-22T10:00:00",
  "Datos": "Nombre=valor; Descripcion=valor"
}

###

POST {{servicio}}/Auditorias/Actualizar
Content-Type: application/json
X-Usuario: {{usuario}}

{
  "Id": 1,
  "Entidad": "Cargos",
  "Llave": 1,
  "Operacion": "Insertar",
  "Usuario": "admin@tiendafajas.com",
  "Fecha": "2026-11-22T10:00:00",
  "Datos": "Nombre=valor; Descripcion=valor"
}

###

POST {{servicio}}/Auditorias/Consultar
Content-Type: application/json
X-Usuario: {{usuario}}

{}

