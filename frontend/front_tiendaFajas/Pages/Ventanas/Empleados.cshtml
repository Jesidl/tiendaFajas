@page
@model EmpleadosModel
@{
    ViewData["Title"] = "Empleados";
}
<form method="post"
    enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Empleados</h1>

        <input type="submit"
            value="Buscar"
            class="btn btn-secondary"
            asp-page-handler="BtBuscar"/>
        <input type="submit"
            value="Nuevo"
            class="btn btn-secondary"
            asp-page-handler="BtNuevo"/>
        <input type="submit"
            value="Guardar"
            class="btn btn-secondary"
            asp-page-handler="BtGuardar"/>
        <input id="flNombre"
            placeholder="Nombre"
            asp-for="@Model.Filtro!.Nombre"/>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml");
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input id="nmId"
                type="hidden"
                asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Empleados</h3>

                <label>
                    Cedula
                </label>
                <input id="nmCedula"
                    asp-for="@Model.Actual!.Cedula" />
                <br />

                <label>
                    Nombre
                </label>
                <input id="nmNombre"
                    asp-for="@Model.Actual!.Nombre" />
                <br />

                <label>
                    Telefono
                </label>
                <input id="nmTelefono"
                    asp-for="@Model.Actual!.Telefono" />
                <br />

                <label>
                    Sucursal
                </label>
                <select id="nmSucursal"
                    asp-for="@Model.Actual!.Sucursal"
                    asp-items="@(new SelectList(Model.Sucursales, "Id", "Nombre"))">
                </select>
                <br />

                <label>
                    Cargo
                </label>
                <select id="nmCargo"
                    asp-for="@Model.Actual!.Cargo"
                    asp-items="@(new SelectList(Model.Cargos, "Id", "Nombre"))">
                </select>
                <br />

            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>Mensaje</h3>

                    <h4>
                        ¿Desea borrar el registro?
                    </h4>
                    <h6>
                        @Model.Actual!.Cedula,
                        @Model.Actual!.Nombre,
                        @Model.Actual!.Telefono
                    </h6>
                    <input type="submit"
                        value="Cancelar"
                        class="btn btn-secondary"
                        asp-page-handler="BtBuscar" />
                    <input type="submit"
                        value="Borrar"
                        class="btn btn-secondary"
                        asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>Cedula</th>
                        <th>Nombre</th>
                        <th>Telefono</th>
                        <th>Sucursal</th>
                        <th>Cargo</th>
                        <th>Acción</th>
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.Cedula</td>
                                <td>@elemento.Nombre</td>
                                <td>@elemento.Telefono</td>
                                <td>@elemento._Sucursal!.Nombre</td>
                                <td>@elemento._Cargo!.Nombre</td>
                                <td>
                                    <input type="submit"
                                        value="Editar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtEditar"
                                        asp-route-data="@elemento.Id" />
                                    <input type="submit"
                                        value="Borrar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtPregBorrar"
                                        asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

    </div>
</form>