@page
@model VentasModel
@{
    ViewData["Title"] = "Ventas";
}
<form method="post"
    enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Ventas</h1>

        <input type="submit"
            value="Buscar"
            class="btn btn-secondary"
            asp-page-handler="BtBuscar"/>
        <input type="submit"
            value="Nuevo"
            class="btn btn-secondary"
            asp-page-handler="BtNuevo"/>
        <input type="submit"
            value="Guardar"
            class="btn btn-secondary"
            asp-page-handler="BtGuardar"/>
        <input id="flCodigo"
            placeholder="Codigo"
            asp-for="@Model.Filtro!.Codigo"/>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml");
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input id="nmId"
                type="hidden"
                asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Ventas</h3>

                <label>
                    Codigo
                </label>
                <input id="nmCodigo"
                    asp-for="@Model.Actual!.Codigo" />
                <br />

                <label>
                    Cliente
                </label>
                <select id="nmCliente"
                    asp-for="@Model.Actual!.Cliente"
                    asp-items="@(new SelectList(Model.Clientes, "Id", "Nombre"))">
                </select>
                <br />

                <label>
                    Empleado
                </label>
                <select id="nmEmpleado"
                    asp-for="@Model.Actual!.Empleado"
                    asp-items="@(new SelectList(Model.Empleados, "Id", "Nombre"))">
                </select>
                <br />

                <label>
                    Fecha
                </label>
                <input id="nmFecha"
                    asp-for="@Model.Actual!.Fecha" />
                <br />

                <label>
                    Total
                </label>
                <input id="nmTotal"
                    asp-for="@Model.Actual!.Total" />
                <br />

            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>Mensaje</h3>

                    <h4>
                        ¿Desea borrar el registro?
                    </h4>
                    <h6>
                        @Model.Actual!.Codigo,
                        @Model.Actual!._Cliente!.Nombre,
                        @Model.Actual!._Empleado!.Nombre
                    </h6>
                    <input type="submit"
                        value="Cancelar"
                        class="btn btn-secondary"
                        asp-page-handler="BtBuscar" />
                    <input type="submit"
                        value="Borrar"
                        class="btn btn-secondary"
                        asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>Codigo</th>
                        <th>Cliente</th>
                        <th>Empleado</th>
                        <th>Fecha</th>
                        <th>Total</th>
                        <th>Acción</th>
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.Codigo</td>
                                <td>@elemento._Cliente!.Nombre</td>
                                <td>@elemento._Empleado!.Nombre</td>
                                <td>@elemento.Fecha</td>
                                <td>@elemento.Total</td>
                                <td>
                                    <input type="submit"
                                        value="Editar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtEditar"
                                        asp-route-data="@elemento.Id" />
                                    <input type="submit"
                                        value="Borrar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtPregBorrar"
                                        asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

    </div>
</form>