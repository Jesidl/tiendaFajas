@page
@model PagosModel
@{
    ViewData["Title"] = "Pagos";
}
<form method="post"
    enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Pagos</h1>

        <input type="submit"
            value="Buscar"
            class="btn btn-secondary"
            asp-page-handler="BtBuscar"/>
        <input type="submit"
            value="Nuevo"
            class="btn btn-secondary"
            asp-page-handler="BtNuevo"/>
        <input type="submit"
            value="Guardar"
            class="btn btn-secondary"
            asp-page-handler="BtGuardar"/>
        <input id="flFiltro"
            placeholder="Filtro"
            asp-for="@Model.Filtro!.Filtro"/>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml");
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input id="nmId"
                type="hidden"
                asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Pagos</h3>

                <label>
                    Venta
                </label>
                <select id="nmVenta"
                    asp-for="@Model.Actual!.Venta"
                    asp-items="@(new SelectList(Model.Ventas, "Id", "Codigo"))">
                </select>
                <br />

                <label>
                    Metodo Pago
                </label>
                <select id="nmMetodo_Pago"
                    asp-for="@Model.Actual!.Metodo_Pago"
                    asp-items="@(new SelectList(Model.Metodos_Pago, "Id", "Nombre"))">
                </select>
                <br />

                <label>
                    Valor
                </label>
                <input id="nmValor"
                    asp-for="@Model.Actual!.Valor" />
                <br />

                <label>
                    Fecha
                </label>
                <input id="nmFecha"
                    asp-for="@Model.Actual!.Fecha" />
                <br />

            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>Mensaje</h3>

                    <h4>
                        ¿Desea borrar el registro?
                    </h4>
                    <h6>
                        @Model.Actual!._Venta!.Codigo,
                        @Model.Actual!._Metodo_Pago!.Nombre,
                        @Model.Actual!.Valor
                    </h6>
                    <input type="submit"
                        value="Cancelar"
                        class="btn btn-secondary"
                        asp-page-handler="BtBuscar" />
                    <input type="submit"
                        value="Borrar"
                        class="btn btn-secondary"
                        asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>Venta</th>
                        <th>Metodo Pago</th>
                        <th>Valor</th>
                        <th>Fecha</th>
                        <th>Acción</th>
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento._Venta!.Codigo</td>
                                <td>@elemento._Metodo_Pago!.Nombre</td>
                                <td>@elemento.Valor</td>
                                <td>@elemento.Fecha</td>
                                <td>
                                    <input type="submit"
                                        value="Editar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtEditar"
                                        asp-route-data="@elemento.Id" />
                                    <input type="submit"
                                        value="Borrar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtPregBorrar"
                                        asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

    </div>
</form>