@page
@model ProductosModel
@{
    ViewData["Title"] = "Productos";
}
<form method="post"
    enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Productos</h1>

        <input type="submit"
            value="Buscar"
            class="btn btn-secondary"
            asp-page-handler="BtBuscar"/>
        <input type="submit"
            value="Nuevo"
            class="btn btn-secondary"
            asp-page-handler="BtNuevo"/>
        <input type="submit"
            value="Guardar"
            class="btn btn-secondary"
            asp-page-handler="BtGuardar"/>
        <input id="flNombre"
            placeholder="Nombre"
            asp-for="@Model.Filtro!.Nombre"/>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml");
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input id="nmId"
                type="hidden"
                asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Productos</h3>

                <label>
                    Codigo
                </label>
                <input id="nmCodigo"
                    asp-for="@Model.Actual!.Codigo" />
                <br />

                <label>
                    Nombre
                </label>
                <input id="nmNombre"
                    asp-for="@Model.Actual!.Nombre" />
                <br />

                <label>
                    Descripcion
                </label>
                <input id="nmDescripcion"
                    asp-for="@Model.Actual!.Descripcion" />
                <br />

                <label>
                    Precio
                </label>
                <input id="nmPrecio"
                    asp-for="@Model.Actual!.Precio" />
                <br />

                <label>
                    Estado
                </label>
                <input id="nmEstado"
                    asp-for="@Model.Actual!.Estado" />
                <br />

                <label>
                    Categoria
                </label>
                <select id="nmCategoria"
                    asp-for="@Model.Actual!.Categoria"
                    asp-items="@(new SelectList(Model.Categorias, "Id", "Nombre"))">
                </select>
                <br />

                <label>
                    Marca
                </label>
                <select id="nmMarca"
                    asp-for="@Model.Actual!.Marca"
                    asp-items="@(new SelectList(Model.Marcas, "Id", "Nombre"))">
                </select>
                <br />

                <label>
                    Material
                </label>
                <select id="nmMaterial"
                    asp-for="@Model.Actual!.Material"
                    asp-items="@(new SelectList(Model.Materiales, "Id", "Nombre"))">
                </select>
                <br />

                <hr />
                <h4>Im&aacute;genes</h4>

                @*
                    El src apunta al servicio, no al front: el binario no pasa
                    por este proceso. El navegador lo descarga con un GET, que
                    es lo unico que sabe hacer una etiqueta img.
                *@
                @if (Model.Actual!.Id != 0)
                {
                    <div class="gl_imagenes">
                        @if (Model.Imagenes != null && Model.Imagenes.Count > 0)
                        {
                            foreach (var imagen in Model.Imagenes)
                            {
                                <div class="gl_item">
                                    <img src="@Model.UrlImagen(imagen.Id)"
                                        alt="@imagen.Nombre"
                                        title="@imagen.Nombre" />
                                    <div class="gl_pie">
                                        @imagen.Nombre
                                        <br />
                                        @(imagen.Tamano / 1024) KB
                                    </div>
                                    <input type="submit"
                                        value="Quitar"
                                        class="btn btn-secondary btn-sm"
                                        asp-page-handler="BtBorrarImagen"
                                        asp-route-data="@imagen.Id" />
                                </div>
                            }
                        }
                        else
                        {
                            <p class="gl_vacia">
                                Este producto todav&iacute;a no tiene im&aacute;genes.
                            </p>
                        }
                    </div>

                    <label>
                        Archivo
                    </label>
                    <input id="nmArchivo"
                        type="file"
                        accept="image/png,image/jpeg,image/webp,image/gif"
                        asp-for="Archivo" />
                    <input type="submit"
                        value="Subir imagen"
                        class="btn btn-secondary"
                        asp-page-handler="BtSubir" />
                    <br />
                    <small>PNG, JPEG, WEBP o GIF, hasta 4 MB.</small>
                    <br />
                }
                else
                {
                    <p class="gl_vacia">
                        Guarde el producto para poder subirle im&aacute;genes.
                    </p>
                }

            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>Mensaje</h3>

                    <h4>
                        ¿Desea borrar el registro?
                    </h4>
                    <h6>
                        @Model.Actual!.Codigo,
                        @Model.Actual!.Nombre,
                        @Model.Actual!.Descripcion
                    </h6>
                    <input type="submit"
                        value="Cancelar"
                        class="btn btn-secondary"
                        asp-page-handler="BtBuscar" />
                    <input type="submit"
                        value="Borrar"
                        class="btn btn-secondary"
                        asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>Codigo</th>
                        <th>Nombre</th>
                        <th>Descripcion</th>
                        <th>Precio</th>
                        <th>Estado</th>
                        <th>Categoria</th>
                        <th>Marca</th>
                        <th>Material</th>
                        <th>Acción</th>
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.Codigo</td>
                                <td>@elemento.Nombre</td>
                                <td>@elemento.Descripcion</td>
                                <td>@elemento.Precio</td>
                                <td>@elemento.Estado</td>
                                <td>@elemento._Categoria!.Nombre</td>
                                <td>@elemento._Marca!.Nombre</td>
                                <td>@elemento._Material!.Nombre</td>
                                <td>
                                    <input type="submit"
                                        value="Editar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtEditar"
                                        asp-route-data="@elemento.Id" />
                                    <input type="submit"
                                        value="Borrar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtPregBorrar"
                                        asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

    </div>
</form>